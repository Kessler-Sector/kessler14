<contracts:ContractsUiFragment xmlns:contracts="clr-namespace:Content.Client._Kessler.Contracts"
                               xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"></PanelContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 4">
            <Label Text="{Loc 'kessler-contracts-title'}" StyleClasses="LabelBig" HorizontalExpand="True"/>
            <Button Name="RefreshButton" Text="{Loc 'kessler-contracts-refresh'}"/>
        </BoxContainer>
        <RichTextLabel Name="Hint" Margin="8 0 8 4"/>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ContractList" Orientation="Vertical" HorizontalExpand="True" Margin="8 0"/>
        </ScrollContainer>
    </BoxContainer>
</contracts:ContractsUiFragment>
