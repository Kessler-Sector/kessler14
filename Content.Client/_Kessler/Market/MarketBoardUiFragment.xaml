<market:MarketBoardUiFragment xmlns:market="clr-namespace:Content.Client._Kessler.Market"
                              xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"></PanelContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 4">
            <Label Text="{Loc 'kessler-market-board-title'}" StyleClasses="LabelBig" HorizontalExpand="True"/>
            <Button Name="RefreshButton" Text="{Loc 'kessler-market-board-refresh'}"/>
        </BoxContainer>
        <Label Text="{Loc 'kessler-market-board-hint'}" FontColorOverride="#a0a0a0" Margin="8 0 8 4"/>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="StationList" Orientation="Vertical" HorizontalExpand="True" Margin="8 0"/>
        </ScrollContainer>
    </BoxContainer>
</market:MarketBoardUiFragment>
